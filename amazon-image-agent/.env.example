# Amazon Image Agent - Environment Variables
# Copy this file to .env and fill in your values

# Krea AI API Key (get from https://krea.ai/app/api/tokens)
KREA_API_KEY=your_krea_api_key_here

# Amazon Settings
AMAZON_MARKETPLACE=amazon.in
AMAZON_SELLER_ID=your_seller_id_here

# Optional: Amazon SP-API credentials (if using Selling Partner API)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# SP_API_REFRESH_TOKEN=your_refresh_token
